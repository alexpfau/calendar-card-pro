// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a representative month > matches its snapshot 1`] = `
"<div class="month-container" style="--calendar-card-month-row-height:112px;">
<div class="month-weekdays">
<div class=" month-weekday ">

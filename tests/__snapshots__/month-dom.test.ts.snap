<span class="month-line-time">until 1:30</span>
</div>
<button class="month-more" type="button" style="grid-column:2;grid-row:5;" aria-label="+2 more, Tuesday, November 10">
    +2 more
  </button>
</div>
<div class="month-week" style="grid-template-rows:auto repeat(4, auto) minmax(0, 1fr);">

<div class="month-date" style="grid-column:5;">
<span class="day" style="color:var(--primary-text-color);">20</span>
</div>
<div class=" month-day weekend " style="grid-column:6;"></div>
<div class="month-date" style="grid-column:6;">
<span class="day" style="color:var(--primary-text-color);">21</span>
</div>

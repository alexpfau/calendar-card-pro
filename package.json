{
  "name": "calendar-card-pro",
  "version": "5.0.0",
  "description": "Custom Home Assistant calendar card",
  "main": "dist/calendar-card-pro.js",
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "cross-env NODE_ENV=prod rollup -c",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.mjs' --fix --format stylish",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexpfau/calendar-card-pro.git"
  },
  "keywords": [
    "calendar",
    "card",
    "home-assistant",
    "homeassistant",
    "hacs",
    "lovelace",
    "custom-card"
  ],
  "author": "Alex Pfau",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexpfau/calendar-card-pro/issues"
  },
  "homepage": "https://calendar-card-pro.alexpfau.com",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "rollup": "^4.64.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "dayjs": "^1.11.23",
    "lit": "^3.3.3"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    }
  }
}

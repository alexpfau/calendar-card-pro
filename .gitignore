# Ignore dist/ and docs/ folder
dist/*

# Generated by scripts/l10n-handoff.mjs, an authoring tool
l10n-handoff/

# Ignore system-specific and editor-related files
.DS_Store
.vscode/*

# Ignore logs
logs/
*.log
npm-debug.log*

# Ignore dependencies
node_modules/

# Ignore runtime/process data
pids/
*.pid
*.seed
*.pid.lock

# Ignore build-related files
build/
build/Release/

# Ignore cache and temporary files
.cache/
tmp/
.undefined/
*.tgz

# Ignore environment variables
.env
.env.test

# Ignore project-specific caches and artifacts
.eslintcache

# Ignore documentation build artifacts
docs/_build/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Ignore Cloudflare Workers local state
.wrangler/

# Ignore local-only MCP server config (may contain access tokens)
.mcp.json

# Local agent skills (machine-specific, not for contributors).
# No trailing slash: worktrees reach these through a symlink, and a
# `.agents/` pattern matches real directories only, so the link would
# be left untracked and could be committed.
.agents

# Agent scratch. In .gitignore rather than .git/info/exclude on purpose: a local exclude
# does not travel, so a fresh clone and CI cannot reproduce it -- the same lesson
# .prettierignore already records. A sandbox here was swept in by `git add -A` once,
# 326 files and 14 MB including a node_modules symlink.
.probe-sandbox/

# Design-review hook cache. Same class as the sandbox above, and it reached `dev` the same
# way: it records per-session findings keyed by ABSOLUTE paths inside a worktree, so it is
# machine-specific, it churns on every edit, and it is worthless to anyone else. Committed
# once at 2 KB carrying a session UUID and this machine's directory layout.
.impeccable/
